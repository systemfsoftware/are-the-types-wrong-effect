{
  "extends": "../../stryker.config.base.json",
  "mutate": [
    "src/ModuleKind.ts",
    "src/ModuleKindDisagreement.ts",
    "src/ProblemInfo.ts",
    "src/TypesCompanion.ts",
    "src/Utils.ts",
    "!src/**/*.schema.ts",
    "!src/**/*.d.ts",
    "!src/**/*.test.ts",
    "!src/**/__tests__/**"
  ],
  "plugins": [
    "@systemfsoftware/stryker-js-vitest-runner",
    "@systemfsoftware/stryker-js-typescript-checker",
    "@systemfsoftware/stryker-plugins/effect-schema-ignorer",
    "@systemfsoftware/stryker-plugins/in-source-test-ignorer"
  ],
  "ignorers": [
    "effect-schema-declarations",
    "in-source-vitest-block"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "ignorePatterns": null
}
