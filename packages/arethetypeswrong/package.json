{
  "name": "@systemfsoftware/arethetypeswrong",
  "version": "7.0.2",
  "description": "TypeScript package type-checking engine for auditing npm package entry points, module kinds, and export bindings",
  "author": "Ryan Lee <drdgvhbh@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/systemfsoftware/are-the-types-wrong-effect.git",
    "directory": "packages/arethetypeswrong"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "api:check": "api-extractor run",
    "api:update": "api-extractor run --local",
    "build": "tsdown -l warn && pnpm api:check",
    "clean": "rimraf dist",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force",
    "typecheck": "tsc -b",
    "attw": "npm_config_ignore_scripts=true attw --pack .",
    "lint": "f=${OXLINT_FORMAT:-${AGENT:+agent}}; oxlint . --format=${f:-default}",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "type": "module",
  "exports": {
    ".": {
      "@systemfsoftware/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@loaderkit/resolve": "catalog:",
    "@systemfsoftware/npm-package": "catalog:",
    "cjs-module-lexer": "catalog:",
    "effect": "catalog:",
    "semver": "catalog:",
    "typescript": "catalog:attw",
    "validate-npm-package-name": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@systemfsoftware/arethetypeswrong-cli": "catalog:",
    "@systemfsoftware/arethetypeswrong-recipes": "workspace:^",
    "@systemfsoftware/effect-cell-types": "catalog:",
    "@systemfsoftware/effect-gherkin-spec": "catalog:",
    "@systemfsoftware/effect-memfs": "catalog:",
    "@systemfsoftware/effect-schema-law": "catalog:",
    "@systemfsoftware/effect-schema-vite": "catalog:",
    "@systemfsoftware/oxlint-config-recommended": "catalog:",
    "@systemfsoftware/stryker-ignorer-effect-schema-declarations": "catalog:",
    "@systemfsoftware/stryker-ignorer-in-source-vitest-block": "catalog:",
    "@systemfsoftware/stryker-js": "catalog:",
    "@systemfsoftware/stryker-js-typescript-checker": "catalog:",
    "@systemfsoftware/stryker-js-vitest-runner": "catalog:",
    "@systemfsoftware/stryker-test-contribution": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/validate-npm-package-name": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/snapshot": "catalog:",
    "fast-check": "catalog:",
    "oxlint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "inlinedDependencies": {
    "@systemfsoftware/effect-cell-types": "10.1.0"
  }
}
