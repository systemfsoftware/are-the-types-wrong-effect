#!/usr/bin/env sh
set -e
remote=origin

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  main_sha=$(git ls-remote --heads "$remote" main 2>/dev/null | cut -f1)
  if [ -n "$main_sha" ]; then
    if ! git cat-file -e "$main_sha^{commit}" 2>/dev/null; then
      git fetch --quiet "$remote" main || {
        echo "pre-push: could not fetch $remote main." >&2
        exit 1
      }
    fi
    if ! git merge-base --is-ancestor "$main_sha" HEAD; then
      echo "pre-push: main is behind $remote/main ($main_sha)." >&2
      echo "Rebase or merge $remote/main before pushing main." >&2
      exit 1
    fi
  fi
fi

pnpm --silent format:check
pnpm --silent lint
base=$(git merge-base HEAD "$remote/main")
TURBO_SCM_BASE=$base TURBO_SCM_HEAD=HEAD pnpm exec turbo run typecheck lint --affected --output-logs=errors-only
