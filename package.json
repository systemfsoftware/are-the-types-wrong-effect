{
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@systemfsoftware/tsconfig": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "license": "Apache-2.0",
  "name": "are-the-types-wrong",
  "packageManager": "pnpm@11.21.0",
  "private": true,
  "scripts": {
    "attw": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} attw",
    "build": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} build",
    "check:build": "pnpm gate:dist",
    "check:ci": "s=0; pnpm check:static || s=1; pnpm check:types || s=1; pnpm check:tests || s=1; pnpm check:build || s=1; exit $s",
    "check:contract": "pnpm test:e2e",
    "check:static": "s=0; pnpm format:check || s=1; pnpm lint || s=1; exit $s",
    "check:tests": "pnpm test",
    "check:types": "pnpm typecheck",
    "clean": "turbo clean",
    "format": "./bin/dprint fmt",
    "format:check": "./bin/dprint check",
    "gate:dist": "turbo --concurrency=${TURBO_CONCURRENCY:-100%} build",
    "lint": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} lint",
    "mutation": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} mutation",
    "precommit": "pnpm exec lint-staged --no-revert --config .lintstagedrc.js",
    "prepare": "husky",
    "test": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} test",
    "test:e2e": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} test:e2e",
    "typecheck": "turbo --concurrency=${TURBO_CONCURRENCY:-50%} --continue typecheck typecheck:node",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit"
  },
  "type": "module"
}
